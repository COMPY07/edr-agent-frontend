# API 베이스 URL 을 명시적으로 지정하려면 설정한다(선택).
# 미설정 시 기본값(src/App.jsx):
#   - 프로덕션 빌드 → https://asc4.jeonghuncompy.cloud (백엔드 직결, CORS 허용됨)
#   - 로컬 개발     → /edr-api (아래 프록시 사용)
# VITE_EDR_API_BASE_URL=https://asc4.jeonghuncompy.cloud

# 로컬 개발 시 /edr-api 프록시가 넘길 백엔드 주소 (vite.config.js)
EDR_API_PROXY_TARGET=http://127.0.0.1:8888
